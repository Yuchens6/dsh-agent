{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "paths": { "@dsh-agent/contracts": ["./dsh-agent-contracts/src/index.ts"] }
  },
  "include": ["dsh-agent-*/src/**/*.ts", "tests/**/*.ts"]
}
