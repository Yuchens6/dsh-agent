NODE_ENV=development
HOST=127.0.0.1
PORT=8090
KNOWLEDGE_MAX_IN_FLIGHT=16
RUN_CONTROL_URL=http://127.0.0.1:8085
# Set the actual path to the reviewed sources file, with real tenant/user IDs.
KNOWLEDGE_SOURCES_FILE=D:/code/dsh/.local/knowledge/sources.json
RUN_CONTROL_KNOWLEDGE_SECRET=REPLACE_WITH_FIRST_DISTINCT_RANDOM_SECRET
KNOWLEDGE_RUN_CONTROL_SECRET=REPLACE_WITH_SECOND_DISTINCT_RANDOM_SECRET
# PostgreSQL modes use an independently provisioned SELECT-only reader, not chat/workspace credentials.
# KNOWLEDGE_DATABASE_URL=postgresql://knowledge_reader:REPLACE@127.0.0.1:5432/dsh_agent
KNOWLEDGE_DB_POOL_MAX=8
KNOWLEDGE_DB_MAX_WAITING=16
# Only required for LightRAG sources; omit for PostgreSQL-only retrieval.
# Must equal the target LightRAG instance's LIGHTRAG_API_KEY.
LIGHTRAG_PERSONAL_API_KEY=REPLACE_WITH_LIGHTRAG_API_KEY
