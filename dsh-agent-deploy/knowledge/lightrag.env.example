# Copy to a dedicated private directory as .env. Never expose this server to end users.
HOST=127.0.0.1
PORT=9621
WORKSPACE=dsh-personal-handbook
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs
LIGHTRAG_API_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Important: upstream's default /api/* exemption can bypass knowledge authentication.
WHITELIST_PATHS=/health

# Document indexing uses a model. Configure deliberately; indexing incurs costs.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=configure-model

# Independent embedding service required. DeepSeek chat credentials alone are insufficient.
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=false
RERANK_BINDING=null
ENABLE_LLM_CACHE=false
