{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "dsh-agent-stream",
        "namespace": "agent-platform"
      },
      "spec": {
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "dsh-agent-stream"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "dsh-agent-stream"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "stream",
                "image": "change-me/dsh-agent-stream:0.1.0",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "CHAT_CAPABILITY_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "dsh-agent-capability",
                        "key": "CHAT_CAPABILITY_SECRET"
                      }
                    }
                  },
                  {
                    "name": "NATS_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "dsh-agent-stream-nats",
                        "key": "NATS_URL"
                      }
                    }
                  },
                  {
                    "name": "NATS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "dsh-agent-stream-nats",
                        "key": "NATS_TOKEN"
                      }
                    }
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "dsh-agent-config"
                    }
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": "http"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": "http"
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 5,
                  "timeoutSeconds": 5
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "dsh-agent-stream",
        "namespace": "agent-platform"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "dsh-agent-stream"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http"
          }
        ]
      }
    }
  ]
}
